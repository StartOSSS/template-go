{
  "title": "Todo Overview",
  "uid": "todo-default",
  "schemaVersion": 38,
  "refresh": "30s",
  "panels": [
    {
      "type": "stat",
      "title": "Request Rate",
      "datasource": "Prometheus",
      "targets": [
        {"expr": "sum(rate(todo_requests_total[5m]))"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Request Latency p95",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_duration_seconds_bucket[5m])) by (le))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Postgres Connections",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "pg_stat_activity_count"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU / Memory",
      "datasource": "Prometheus",
      "targets": [
        {"expr": "sum(rate(container_cpu_usage_seconds_total{pod=~\"todo.*\"}[5m]))"},
        {"expr": "sum(container_memory_usage_bytes{pod=~\"todo.*\"})"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Ingress / Egress",
      "datasource": "Prometheus",
      "targets": [
        {"expr": "sum(rate(container_network_receive_bytes_total{pod=~\"todo.*\"}[5m]))"},
        {"expr": "sum(rate(container_network_transmit_bytes_total{pod=~\"todo.*\"}[5m]))"}
      ]
    }
  ]
}
